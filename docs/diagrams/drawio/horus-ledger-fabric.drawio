ell><mxCell id="1 a83" value="Componente do ledger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1370" y="940" width="160" height="35" as="geometry"/></mxCell><mxCell id="1 a84" value="Job efemero de analise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;dashed=1;" vertex="1" parent="1"><mxGeometry x="1550" y="940" width="170" height="35" as="geometry"/></mxCell><mxCell id="1 a85" value="Treino DYNAMOS existente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1370" y="990" width="160" height="35" as="geometry"/></mxCell><mxCell id="1 a86" value="Observacao / regra" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1550" y="990" width="170" height="35" as="geometry"/></mxCell><mxCell id="1 a87" value="Azul: gossip/endosso entre peers (7051)&lt;br&gt;Vermelho: Raft entre orderers (7050)&lt;br&gt;Endosso exige MAJORITY (2 de 3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffffff;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="1370" y="1040" width="350" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="2 Fluxo de uma submissao" id="horus-ledger-2"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1440" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2 f1" value="Vida de uma submissao: sorteio por commit-reveal, analise local assinada e auditoria (exemplo: VU sorteada)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffffff;fontSize=18;fontStyle=1;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1700" height="30" as="geometry"/></mxCell><mxCell id="2 f2" value="Pesquisadora / Horus / API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=6;arcSize=2;opacity=60;" vertex="1" parent="1"><mxGeometry x="40" y="45" width="280" height="1360" as="geometry"/></mxCell><mxCell id="2 f3" value="Gateway TUDELFT&lt;br&gt;(researcher)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=6;arcSize=2;opacity=60;" vertex="1" parent="1"><mxGeometry x="330" y="45" width="280" height="1360" as="geometry"/></mxCell><mxCell id="2 f4" value="Canal horus-governance&lt;br&gt;(chaincode nos 3 peers)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#000000;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=6;arcSize=2;opacity=60;" vertex="1" parent="1"><mxGeometry x="620" y="45" width="280" height="1360" as="geometry"/></mxCell><mxCell id="2 f5" value="Agente UVA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=6;arcSize=2;opacity=60;" vertex="1" parent="1"><mxGeometry x="910" y="45" width="280" height="1360" as="geometry"/></mxCell><mxCell id="2 f6" value="Agente VU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=6;arcSize=2;opacity=60;" vertex="1" parent="1"><mxGeometry x="1200" y="45" width="280" height="1360" as="geometry"/></mxCell><mxCell id="2 f7" value="Job SAST efemero&lt;br&gt;(namespace da organizacao)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;fontStyle=1;verticalAlign=top;spacingTop=6;arcSize=2;opacity=60;" vertex="1" parent="1"><mxGeometry x="1490" y="45" width="280" height="1360" as="geometry"/></mxCell><mxCell id="2 f8" value="1. Envia .py ou texto e escolhe UVA, VU, TUDELFT. API valida (UTF-8, 900 KiB), normaliza e calcula code_hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="240" height="75" as="geometry"/></mxCell><mxCell id="2 f9" value="2. SubmitCode assinado pela identidade researcher" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="198" width="240" height="75" as="geometry"/></mxCell><mxCell id="2 f10" value="3. Chaincode: organizacao pelo certificado (TUDELFT), elegiveis UVA e VU, guarda o codigo. Status drawing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="286" width="240" height="75" as="geometry"/></mxCell><mxCell id="2 f11" value="4a. Gera segredo, salva no proprio volume e envia CommitSeed(SHA-256 do segredo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="374" width="240" height="75" as="geometry"/></mxCell><mxCell id="2 f12" value="4b. Gera segredo, salva no proprio volume e envia CommitSeed(SHA-256 do segredo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1220" y="374" width="240" height="75" as="geometry"/></mxCell><mxCell id="2 f13" value="5a. Todos fizeram commit: RevealSeed(segredo UVA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="462" width="240" height="75" as="geometry"/></mxCell><mxCell id="2 f14" value="5b. RevealSeed(segredo VU)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1220" y="462" width="240" height="75" as="geometry"/></mxCell><mxCell id="2 f15" value="6. Ultimo reveal sorteia: semente = SHA-256(code_hash + segredos); menor SHA-256(semente + org) vence. Status assigned" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="550" width="240" height="75" as="geometry"/></mxCell><mxCell id="2 f16" value="7. VU sorteada: GetCode no proprio peer e confere o SHA-256 com o ledger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1220" y="638" width="240" height="75" as="geometry"/></mxCell><mxCell id="2 f17" value="8. Job no namespace vu: ast.parse + Semgrep, sem rede, sem token; relatorio JSON canonico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1510" y="726" width="240" height="75" as="geometry"/></mxCell><mxCell id="2 f18" value="9. Confere report_hash, code_hash, organizacao e digest da imagem; RecordAnalysis assinado por VuMSP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1220" y="814" width="240" height="75" as="geometry"/></mxCell><mxCell id="2 f19" value="10. Chaincode confere: e a sorteada? regras, politica, Semgrep e imagem acordados? recalcula nota e decisao. Status approved ou rejected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="902" width="240" height="75" as="geometry"/></mxCell><mxCell id="2 f20" value="11. UVA reanalisa no namespace uva (mesmo relatorio deterministico) e envia AuditAnalysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="930" y="990" width="240" height="75" as="geometry"/></mxCell><mxCell id="2 f21" value="12. Hash igual: confirmado. Diferente: disputed (sai do catalogo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="1078" width="240" height="75" as="geometry"/></mxCell><mxCell id="2 f22" value="13. Horus mostra as 5 etapas, quem assinou e as auditorias; /ledger mostra bloco e VALID; ledger verify compara os 3 peers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="1166" width="240" height="75" as="geometry"/></mxCell><mxCell id="2 f23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="2 f8" target="2 f9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2 f24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="2 f9" target="2 f10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2 f25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="2 f10" target="2 f11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2 f26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="2 f10" target="2 f12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2 f27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="2 f11" target="2 f13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2 f28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="2 f12" target="2 f14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2 f29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="2 f15" target="2 f16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2 f30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="2 f16" target="2 f17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2 f31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="2 f17" target="2 f18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2 f32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="2 f18" target="2 f19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2 f33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="2 f19" target="2 f20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2 f34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="2 f20" target="2 f21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2 f35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="2 f21" target="2 f22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2 f36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="2 f13" target="2 f15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050.0" y="544"/></Array></mxGeometry></mxCell><mxCell id="2 f37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="2 f14" target="2 f15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1340.0" y="544"/></Array></mxGeometry></mxCell><mxCell id="2 f38" value="Se uma organizacao nao revelar em 600 s, quem revelou chama ForceDraw: a ausente fica marcada como defaulted e nao concorre.&lt;br&gt;Falha de infraestrutura (scanner_unavailable): a revisora tenta de novo. Python invalido: error definitivo.&lt;br&gt;MVCC_READ_CONFLICT: duas organizacoes escreveram a mesma submissao no mesmo bloco; o agente repete em 3 s." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="60" y="1290" width="1660" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 Como o ledger nasce" id="horus-ledger-3"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3 c1" value="python3 tools.py ledger setup - cada etapa age como o operador de UMA organizacao; entre organizacoes so passa material publico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffffff;fontSize=17;fontStyle=1;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1400" height="30" as="geometry"/></mxCell><mxCell id="3 c2" value="A. Construir horus-ledger:local (chaincode, agente, gateway) e imagens SAST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="620" height="80" as="geometry"/></mxCell><mxCell id="3 c3" value="B. Calcular configuracao acordada: membros/MSPs, hashes de regras e politica, Semgrep, digest da imagem de cada org" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="165" width="620" height="80" as="geometry"/></mxCell><mxCell id="3 c4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="3 c2" target="3 c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 c5" value="C. Carregar imagens no kind (nada e baixado no cluster)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="620" height="80" as="geometry"/></mxCell><mxCell id="3 c6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="3 c3" target="3 c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 c7" value="D. Secret ledger-ca-bootstrap em CADA namespace; token do gateway em tudelft" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="375" width="620" height="80" as="geometry"/></mxCell><mxCell id="3 c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="3 c5" target="3 c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 c9" value="E. Helm: CA, matricula, orderer, peer e console em CADA organizacao" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="620" height="80" as="geometry"/></mxCell><mxCell id="3 c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="3 c7" target="3 c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 c11" value="F. Job ledger-enroll: cada CA emite peer0, orderer0, orgadmin, sast-agent (+ researcher na TUDELFT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="585" width="620" height="80" as="geometry"/></mxCell><mxCell id="3 c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="3 c9" target="3 c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 c13" value="G. Coletar /crypto/public das 3 orgs (recusado se tiver chave)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="620" height="80" as="geometry"/></mxCell><mxCell id="3 c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="3 c11" target="3 c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 c15" value="H. Console TUDELFT gera o bloco genese (configtxgen)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="795" width="620" height="80" as="geometry"/></mxCell><mxCell id="3 c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="3 c13" target="3 c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 c17" value="I. CADA org junta o SEU orderer ao canal (osnadmin) -&gt; Raft com 3 consenters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="60" width="620" height="80" as="geometry"/></mxCell><mxCell id="3 c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="3 c15" target="3 c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 c19" value="J. CADA org junta o SEU peer ao canal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="165" width="620" height="80" as="geometry"/></mxCell><mxCell id="3 c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="3 c17" target="3 c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 c21" value="K. CADA org instala pacote ccaas deterministico e sobe horus-chaincode" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="270" width="620" height="80" as="geometry"/></mxCell><mxCell id="3 c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="3 c19" target="3 c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 c23" value="L. CADA org aprova a definicao do chaincode com a SUA chave de admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="375" width="620" height="80" as="geometry"/></mxCell><mxCell id="3 c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="3 c21" target="3 c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 c25" value="M. Commit da definicao (MAJORITY de endosso)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="480" width="620" height="80" as="geometry"/></mxCell><mxCell id="3 c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="3 c23" target="3 c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 c27" value="N. InitConfig: o chaincode de cada org compara com a SUA copia local" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="585" width="620" height="80" as="geometry"/></mxCell><mxCell id="3 c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="3 c25" target="3 c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 c29" value="O. Sobem os horus-sast-agent (conferem a configuracao) e o gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="690" width="620" height="80" as="geometry"/></mxCell><mxCell id="3 c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="3 c27" target="3 c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 c31" value="P. Verificacao cruzada: mesma altura, mesmo hash e config=agreed nos 3 peers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="795" width="620" height="80" as="geometry"/></mxCell><mxCell id="3 c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;" edge="1" parent="1" source="3 c29" target="3 c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3 c33" value="Legenda" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="60" y="920" width="1320" height="100" as="geometry"/></mxCell><mxCell id="3 c34" value="Script no Mac" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="960" width="200" height="40" as="geometry"/></mxCell><mxCell id="3 c35" value="Feito em CADA organizacao, no proprio namespace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="960" width="330" height="40" as="geometry"/></mxCell><mxCell id="3 c36" value="Feito pela TUDELFT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="960" width="200" height="40" as="geometry"/></mxCell><mxCell id="3 c37" value="So material publico / conferencia entre todas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="870" y="960" width="330" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
