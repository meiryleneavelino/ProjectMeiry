estar e observar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="900" y="50" width="860" height="1220" as="geometry"/></mxCell><mxCell id="3 c20" value="Treino federado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="90" width="800" height="32" as="geometry"/></mxCell><mxCell id="3 c21" value="python3 configuration/federated-training/manage.py verify&lt;br&gt;python3 configuration/federated-training/test_run.py&lt;br&gt;Tela /training: Isolation verified; acompanhar Jobs com k get pods -A -w" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;spacingLeft=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="930" y="122" width="800" height="80" as="geometry"/></mxCell><mxCell id="3 c22" value="Governança (Fabric 3 orgs + SAST local)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="232" width="800" height="32" as="geometry"/></mxCell><mxCell id="3 c23" value="(cd horus-governance/ledger &amp;&amp; go test ./...)&lt;br&gt;.venv/bin/python -m unittest discover -s tests&lt;br&gt;HORUS_GOV_LIVE_TESTS=1 .venv/bin/python -m unittest tests.test_live&lt;br&gt;k get pods -A -l app=horus-sast -w   e enviar um arquivo NOVO&lt;br&gt;(mesmo hash = resultado reaproveitado, sem Job)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;spacingLeft=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="930" y="264" width="800" height="120" as="geometry"/></mxCell><mxCell id="3 c24" value="Prontuário FHIR (Fabric 2 orgs)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#0e8088;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="414" width="800" height="32" as="geometry"/></mxCell><mxCell id="3 c25" value="python3 tools.py test   (Go + pytest unitário + integração)&lt;br&gt;python3 tools.py test-isolation   (não mexe no resto)&lt;br&gt;python3 scenario.py --reset --revoke   (passos 0-6)&lt;br&gt;python3 tools.py bench   (latência e vazão)&lt;br&gt;Tela /fhir/access: escolher persona, abrir exame, ver o rastro" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;spacingLeft=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="930" y="446" width="800" height="120" as="geometry"/></mxCell><mxCell id="3 c26" value="Observar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="596" width="800" height="32" as="geometry"/></mxCell><mxCell id="3 c27" value="k get pods -A   ·   python3 horus-governance/tools.py ledger status&lt;br&gt;python3 horus-fhir/tools.py status   ·   docker logs -f fhir-api&lt;br&gt;Telas /ledger (governança) e /fhir/audit (FHIR)&lt;br&gt;Evidências: horus-fhir/.local/scenario-last.json e bench-*.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;spacingLeft=12;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="930" y="628" width="800" height="100" as="geometry"/></mxCell><mxCell id="3 c28" value="Documentação" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="758" width="800" height="32" as="geometry"/></mxCell><mxCell id="3 c29" value="docs/HORUS_GUIA_COMPLETO.md · docs/ledger-fabric-e-sast-local.md&lt;br&gt;docs/fhir-consentimento.md · docs/passo-a-passo-observar-treinamento.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;align=left;spacingLeft=12;font