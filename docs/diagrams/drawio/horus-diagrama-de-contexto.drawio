<mxfile host="horus" agent="generated" version="24.0.0"><diagram name="Diagrama de contexto" id="horus-context-1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="dia1" value="&lt;b&gt;Horus: diagrama de contexto do MVP&lt;/b&gt;  ·  dentro da fronteira = implementado  ·  caixas tracejadas = fora do MVP (outro sistema, via API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffffff;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="0" width="1820" height="34" as="geometry"/></mxCell><mxCell id="dia2" value="Legenda" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="360" height="190" as="geometry"/></mxCell><mxCell id="dia3" value="Implementado no MVP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5ff;strokeColor=#1f4e99;fontSize=11;" vertex="1" parent="1"><mxGeometry x="55" y="85" width="160" height="34" as="geometry"/></mxCell><mxCell id="dia4" value="Fora do MVP: sistema externo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9a9a9a;fontSize=11;dashed=1;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="230" y="85" width="160" height="34" as="geometry"/></mxCell><mxCell id="dia5" value="&lt;b&gt;Esquerda:&lt;/b&gt; o Horus &lt;b&gt;consumiria&lt;/b&gt; a API do sistema.&lt;br&gt;&lt;b&gt;Direita:&lt;/b&gt; o Horus &lt;b&gt;forneceria&lt;/b&gt; API ao sistema.&lt;br&gt;&lt;i&gt;No MVP:&lt;/i&gt; o substituto usado hoje.&lt;br&gt;Atores: personas simuladas (pseudônimos)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="55" y="130" width="335" height="100" as="geometry"/></mxCell><mxCell id="dia6" value="&lt;b&gt;Fronteira do MVP&lt;/b&gt;: tudo roda numa só máquina (Docker Desktop + kind), com dados fictícios. Organizações, identidades e integrações reais ficam fora e entrariam pelas APIs indicadas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1500" y="50" width="360" height="80" as="geometry"/></mxCell><mxCell id="dia7" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef5ff;strokeColor=#1f4e99;fontSize=12;arcSize=2;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="960" height="740" as="geometry"/></mxCell><mxCell id="dia8" value="&lt;b&gt;Horus (MVP, sandbox)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=16;align=left;" vertex="1" parent="1"><mxGeometry x="485" y="308" width="400" height="26" as="geometry"/></mxCell><mxCell id="dia9" value="&lt;b&gt;Horus front-end&lt;/b&gt; (React + Vite :5175): telas Training, Ledger e Prontuário (FHIR)&lt;br&gt;proxies /training-api · /governance-api · /fhir-api; tokens só no servidor do Vite" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e99;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="345" width="920" height="55" as="geometry"/></mxCell><mxCell id="dia10" value="Treino federado (DYNAMOS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="490" y="430" width="290" height="460" as="geometry"/></mxCell><mxCell id="dia11" value="• Iniciar, acompanhar e cancelar treino&lt;br&gt;• FedAvg horizontal (regressão logística)&lt;br&gt;• api-gateway, policy-enforcer, orchestrator&lt;br&gt;• agente de treino por organização&lt;br&gt;• RabbitMQ + etcd&lt;br&gt;• Baixar o modelo treinado&lt;br&gt;• 3 organizações = 3 namespaces no kind&lt;br&gt;• Dados sintéticos, montados readOnly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="498" y="468" width="274" height="410" as="geometry"/></mxCell><mxCell id="dia12" value="Governança zero-trust" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="805" y="430" width="290" height="460" as="geometry"/></mxCell><mxCell id="dia13" value="• Submissão do algoritmo (commit-reveal)&lt;br&gt;• Sorteio da organização revisora&lt;br&gt;• Semgrep no namespace da sorteada&lt;br&gt;• Relatório assinado + auditoria por re-execução&lt;br&gt;• Fabric horus-governance (3 orgs, Raft)&lt;br&gt;• Treino só começa se o código foi aprovado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="813" y="468" width="274" height="410" as="geometry"/></mxCell><mxCell id="dia14" value="Prontuário com consentimento (FHIR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0f0ef;strokeColor=#0e8088;fontSize=14;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1120" y="430" width="290" height="460" as="geometry"/></mxCell><mxCell id="dia15" value="• Consentimento paciente → médico(a), com prazo e revogação&lt;br&gt;• PEP (FastAPI :8099)&lt;br&gt;• ABAC em chaincode: PAP · PIP · PDP, nega por padrão&lt;br&gt;• HAPI FHIR R4: dado clínico fica só aqui&lt;br&gt;• Ledger: só pseudônimos, hashes SHA-256, prazos e decisões&lt;br&gt;• AuditEvent com txId; verificação de hash e tx&lt;br&gt;• Fabric fhir-channel (Hospital + Lab), rede separada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="1128" y="468" width="274" height="410" as="geometry"/></mxCell><mxCell id="dia16" value="aprovação&lt;br&gt;libera treino" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#333333;labelBackgroundColor=#ffffff;endArrow=classic;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia12" target="dia10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dia17" value="&lt;b&gt;Infraestrutura do MVP&lt;/b&gt;: Mac · Docker Desktop · kind (1 nó, Cilium) · Fabric CA locais · segredos em .local/ e Secrets do kind · versões fixadas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="910" width="920" height="45" as="geometry"/></mxCell><mxCell id="dia18" value="&lt;i&gt;Fora do escopo do MVP: autenticação real, integração com sistemas clínicos, organizações em máquinas separadas, monitoração centralizada.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="490" y="965" width="920" height="50" as="geometry"/></mxCell><mxCell id="dia19" value="Pesquisador(a)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e99;fontSize=11;shape=umlActor;verticalLabelPosition=top;verticalAlign=bottom;outlineConnect=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="535.0" y="95" width="30" height="55" as="geometry"/></mxCell><mxCell id="dia20" value="algoritmo, pedido de treino&lt;br&gt;⇄ status, modelo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#1f4e99;labelBackgroundColor=#ffffff;startArrow=classic;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.08333333333333333;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia19" target="dia7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dia21" value="Organizações de dados&lt;br&gt;(UVA · VU · TUDelft)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e99;fontSize=11;shape=umlActor;verticalLabelPosition=top;verticalAlign=bottom;outlineConnect=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="695.0" y="95" width="30" height="55" as="geometry"/></mxCell><mxCell id="dia22" value="aprova, revisa (SAST)&lt;br&gt;⇄ tarefas de treino" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#1f4e99;labelBackgroundColor=#ffffff;startArrow=classic;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia21" target="dia7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dia23" value="Paciente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e99;fontSize=11;shape=umlActor;verticalLabelPosition=top;verticalAlign=bottom;outlineConnect=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="855.0" y="95" width="30" height="55" as="geometry"/></mxCell><mxCell id="dia24" value="concede / revoga&lt;br&gt;⇄ histórico de acessos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#1f4e99;labelBackgroundColor=#ffffff;startArrow=classic;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.4166666666666667;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia23" target="dia7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dia25" value="Médico(a)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e99;fontSize=11;shape=umlActor;verticalLabelPosition=top;verticalAlign=bottom;outlineConnect=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="1015.0" y="95" width="30" height="55" as="geometry"/></mxCell><mxCell id="dia26" value="pede acesso ao exame&lt;br&gt;⇄ exame ou negação" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#1f4e99;labelBackgroundColor=#ffffff;startArrow=classic;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5833333333333334;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia25" target="dia7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dia27" value="Laboratório" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e99;fontSize=11;shape=umlActor;verticalLabelPosition=top;verticalAlign=bottom;outlineConnect=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="1175.0" y="95" width="30" height="55" as="geometry"/></mxCell><mxCell id="dia28" value="publica resultado&lt;br&gt;⇄ txId" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#1f4e99;labelBackgroundColor=#ffffff;startArrow=classic;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia27" target="dia7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dia29" value="Administrador(a)&lt;br&gt;/ auditor(a)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f4e99;fontSize=11;shape=umlActor;verticalLabelPosition=top;verticalAlign=bottom;outlineConnect=0;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="1335.0" y="95" width="30" height="55" as="geometry"/></mxCell><mxCell id="dia30" value="políticas ABAC, auditoria&lt;br&gt;⇄ verificação hash/tx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#1f4e99;labelBackgroundColor=#ffffff;startArrow=classic;endArrow=classic;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.9166666666666666;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia29" target="dia7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dia31" value="&lt;b&gt;Provedor de identidade (IdP / SSO)&lt;/b&gt;&lt;br&gt;API: OpenID Connect · SMART on FHIR&lt;br&gt;→ Horus: login e token com o papel do usuário&lt;br&gt;&lt;i&gt;No MVP: persona escolhida em ?as= + token fixo&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9a9a9a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="360" height="95" as="geometry"/></mxCell><mxCell id="dia32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#888888;labelBackgroundColor=#ffffff;dashed=1;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.06418918918918919;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia31" target="dia7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dia33" value="&lt;b&gt;Registro de profissionais (BIG / UZI)&lt;/b&gt;&lt;br&gt;API: API de consulta do registro&lt;br&gt;→ Horus: confirma que é médico(a) e de qual organização&lt;br&gt;&lt;i&gt;No MVP: atributo role gravado pela Fabric CA local&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9a9a9a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="407" width="360" height="95" as="geometry"/></mxCell><mxCell id="dia34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#888888;labelBackgroundColor=#ffffff;dashed=1;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2087837837837838;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia33" target="dia7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dia35" value="&lt;b&gt;EHR / HIS do hospital&lt;/b&gt;&lt;br&gt;API: FHIR R4 REST&lt;br&gt;→ Horus: Patient, DiagnosticReport e Observation reais&lt;br&gt;&lt;i&gt;No MVP: HAPI FHIR local com dados fictícios&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9a9a9a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="514" width="360" height="95" as="geometry"/></mxCell><mxCell id="dia36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#888888;labelBackgroundColor=#ffffff;dashed=1;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3533783783783784;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia35" target="dia7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dia37" value="&lt;b&gt;LIS do laboratório&lt;/b&gt;&lt;br&gt;API: HL7 v2 (ORU) ou FHIR&lt;br&gt;→ Horus: resultados de exame&lt;br&gt;&lt;i&gt;No MVP: tela Laboratório grava o exame à mão&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9a9a9a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="621" width="360" height="95" as="geometry"/></mxCell><mxCell id="dia38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#888888;labelBackgroundColor=#ffffff;dashed=1;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.497972972972973;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia37" target="dia7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dia39" value="&lt;b&gt;Servidor de terminologia&lt;/b&gt;&lt;br&gt;API: FHIR $validate-code (SNOMED CT, LOINC)&lt;br&gt;→ Horus: valida códigos clínicos&lt;br&gt;&lt;i&gt;No MVP: códigos fixos, sem validação&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9a9a9a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="728" width="360" height="95" as="geometry"/></mxCell><mxCell id="dia40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#888888;labelBackgroundColor=#ffffff;dashed=1;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6425675675675676;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia39" target="dia7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dia41" value="&lt;b&gt;Fontes de dados das organizações&lt;/b&gt;&lt;br&gt;API: catálogo / data lake de cada organização&lt;br&gt;→ Horus: datasets reais para o treino&lt;br&gt;&lt;i&gt;No MVP: dados sintéticos UVA · VU · TUDelft&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9a9a9a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="835" width="360" height="95" as="geometry"/></mxCell><mxCell id="dia42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#888888;labelBackgroundColor=#ffffff;dashed=1;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7871621621621622;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia41" target="dia7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dia43" value="&lt;b&gt;Cofre de segredos / PKI corporativa&lt;/b&gt;&lt;br&gt;API: Vault, HSM, CA da organização&lt;br&gt;→ Horus: chaves e certificados&lt;br&gt;&lt;i&gt;No MVP: arquivos em .local/ e Secrets do kind&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9a9a9a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="942" width="360" height="95" as="geometry"/></mxCell><mxCell id="dia44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#888888;labelBackgroundColor=#ffffff;dashed=1;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9317567567567567;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia43" target="dia7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dia45" value="&lt;b&gt;Portal do paciente / PGO (MedMij)&lt;/b&gt;&lt;br&gt;API: API de consentimento do Horus&lt;br&gt;Horus →: conceder, revogar, ver quem acessou&lt;br&gt;&lt;i&gt;No MVP: tela Consentimento do próprio Horus&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9a9a9a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1500" y="300" width="360" height="95" as="geometry"/></mxCell><mxCell id="dia46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#888888;labelBackgroundColor=#ffffff;dashed=1;endArrow=classic;exitX=1;exitY=0.06418918918918919;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia7" target="dia45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dia47" value="&lt;b&gt;Sistema clínico do médico (EHR)&lt;/b&gt;&lt;br&gt;API: API do PEP (FHIR com decisão)&lt;br&gt;Horus →: exame liberado ou motivo da negação&lt;br&gt;&lt;i&gt;No MVP: tela Acesso do próprio Horus&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9a9a9a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1500" y="407" width="360" height="95" as="geometry"/></mxCell><mxCell id="dia48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#888888;labelBackgroundColor=#ffffff;dashed=1;endArrow=classic;exitX=1;exitY=0.2087837837837838;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia7" target="dia47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dia49" value="&lt;b&gt;SIEM / segurança&lt;/b&gt;&lt;br&gt;API: syslog · OpenTelemetry · eventos da ledger&lt;br&gt;Horus →: AuditEvent e decisões com txId&lt;br&gt;&lt;i&gt;No MVP: tela Auditoria + docker logs / kubectl&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9a9a9a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1500" y="514" width="360" height="95" as="geometry"/></mxCell><mxCell id="dia50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#888888;labelBackgroundColor=#ffffff;dashed=1;endArrow=classic;exitX=1;exitY=0.3533783783783784;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia7" target="dia49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dia51" value="&lt;b&gt;Observabilidade&lt;/b&gt;&lt;br&gt;API: Prometheus · Grafana · Jaeger&lt;br&gt;Horus →: métricas e traces&lt;br&gt;&lt;i&gt;No MVP: logs, probes, Hubble e bench.py&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9a9a9a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1500" y="621" width="360" height="95" as="geometry"/></mxCell><mxCell id="dia52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#888888;labelBackgroundColor=#ffffff;dashed=1;endArrow=classic;exitX=1;exitY=0.497972972972973;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia7" target="dia51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dia53" value="&lt;b&gt;Notificações (e-mail / SMS / push)&lt;/b&gt;&lt;br&gt;API: API de mensagens&lt;br&gt;Horus →: avisar o paciente de acesso ou negação&lt;br&gt;&lt;i&gt;No MVP: não existe&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9a9a9a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1500" y="728" width="360" height="95" as="geometry"/></mxCell><mxCell id="dia54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#888888;labelBackgroundColor=#ffffff;dashed=1;endArrow=classic;exitX=1;exitY=0.6425675675675676;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia7" target="dia53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dia55" value="&lt;b&gt;Registro de modelos (ex.: MLflow)&lt;/b&gt;&lt;br&gt;API: API do registro de modelos&lt;br&gt;Horus →: modelo treinado + proveniência na ledger&lt;br&gt;&lt;i&gt;No MVP: download pela tela Training&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9a9a9a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1500" y="835" width="360" height="95" as="geometry"/></mxCell><mxCell id="dia56" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;strokeColor=#888888;labelBackgroundColor=#ffffff;dashed=1;endArrow=classic;exitX=1;exitY=0.7871621621621622;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dia7" target="dia55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dia57" value="&lt;b&gt;Repositório de código / CI (ex.: GitHub)&lt;/b&gt;&lt;br&gt;API: webhook + status check&lt;br&gt;Horus →: resultado do SAST e da aprovação&lt;br&gt;&lt;i&gt;No MVP: upload manual do arquivo na tela&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9a9a9a;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;dashed=1;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="1500" y="942" width="360" height="95" a