FROM semgrep/semgrep:1.145.0@sha256:b68f9b68483955b85042dac7b4533757779625a02dcf91e470da4c2df1b430be
USER root
WORKDIR /opt/horus
COPY config/policy.json ./config/policy.json
COPY sast/contracts.py sast/analyze.py sast/rules.yaml ./sast/
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONHASHSEED=0 \
    PYTHONUTF8=1 \
    HOME=/tmp \
    XDG_CACHE_HOME=/tmp/.cache \
    SEMGREP_SETTINGS_FILE=/tmp/semgrep-settings.yml \
    SEMGREP_ENABLE_VERSION_CHECK=0 \
    SEMGREP_SEND_METRICS=off \
    LC_ALL=C.UTF-8
USER 10001:10001
ENTRYPOINT ["python3", "-I", "/opt/horus/sast/analyze.py"]