apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: horus-sast-deny-network
  namespace: ${NAMESPACE}
spec:
  podSelector:
    matchLabels:
      app: horus-sast
  policyTypes: [Ingress, Egress]
  ingress: []
  egress: []
---
apiVersion: batch/v1
kind: Job
metadata:
  name: ${JOB_NAME}
  namespace: ${NAMESPACE}
spec:
  backoffLimit: 0
  activeDeadlineSeconds: 120
  ttlSecondsAfterFinished: 600
  template:
    metadata:
      labels:
        app: horus-sast
      annotations:
        linkerd.io/inject: disabled
    spec:
      automountServiceAccountToken: false
      enableServiceLinks: false
      restartPolicy: Never
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        fsGroup: 10001
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: analyzer
          image: "${IMAGE_REFERENCE}"
          imagePullPolicy: IfNotPresent
          command: [/bin/sh, -c]
          args: ["exec python3 -I /opt/horus/sast/analyze.py < /input/submission.py"]
          env:
            - name: HORUS_ORGANIZATION
              value: "${ORGANIZATION}"
          securityContext:
            privileged: false
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop: [ALL]
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: "1"
              memory: 768Mi
          volumeMounts:
            - name: input
              mountPath: /input
              readOnly: true
            - name: temporary
              mountPath: /tmp
      volumes:
        - name: input
          configMap:
            name: ${INPUT_CONFIGMAP}
            defaultMode: 0444
        - name: temporary
          emptyDir:
            medium: Memory
            sizeLimit: 128Mi